{
  "name": "student/parcel-delivery",
  "description": "Сервис доставки посылок с автозагрузкой PSR-4",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "University\\ParcelDelivery\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "University\\ParcelDelivery\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "check": [
      "@php -l public/index.php",
      "@php tests/run.php"
    ]
  },
  "config": {
    "sort-packages": true
  }
}